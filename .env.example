NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
SUPABASE_SECRET_KEY=sb_secret_your_server_only_key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Owner-provided public support form or mailto link. Leave blank until approved.
NEXT_PUBLIC_SUPPORT_URL=
# Web Push. Generate the key pair once with `pnpm exec web-push generate-vapid-keys`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Use a real mailto address or HTTPS URL. Do not use localhost.
VAPID_SUBJECT=mailto:support@example.com
# Shared secret used by the Supabase scheduled delivery request.
CRON_SECRET=

# Setra Adaptive weekly review. Keep the API key server-side.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_WEEKLY_REVIEW_MODEL=gpt-6-luna
