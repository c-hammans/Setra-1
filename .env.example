NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
SUPABASE_SECRET_KEY=sb_secret_your_server_only_key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Owner-provided public support form or mailto link. Leave blank until approved.
NEXT_PUBLIC_SUPPORT_URL=
# Web Push. Generate the key pair once with `pnpm exec web-push generate-vapid-keys`.
# Enable explicitly after beta push testing. Rebuild after changing this setting.
NEXT_PUBLIC_SETRA_PUSH_ENABLED=false
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Use a real mailto address or HTTPS URL. Do not use localhost.
VAPID_SUBJECT=mailto:support@example.com
# Shared secret used by the Supabase scheduled delivery request.
CRON_SECRET=

# Adaptive generation is off unless explicitly enabled. Keep the API key server-side.
SETRA_ADAPTIVE_GENERATION_ENABLED=false
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_WEEKLY_REVIEW_MODEL=gpt-6-luna
OPENAI_ASK_SETRA_MODEL=gpt-6-luna
OPENAI_RECOMMENDATIONS_MODEL=gpt-6-luna

# Optional Stripe test billing, all server-side. Never use live Stripe values.
SETRA_BILLING_ORIGIN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_INDIVIDUAL=
STRIPE_PORTAL_COACHING=
STRIPE_PRICE_PREMIUM_MONTH=
STRIPE_PRICE_PREMIUM_YEAR=
STRIPE_PRICE_ADAPTIVE_MONTH=
STRIPE_PRICE_ADAPTIVE_YEAR=
STRIPE_PRICE_COACH_STARTER_MONTH=
STRIPE_PRICE_COACH_MONTH=
STRIPE_PRICE_COACH_PRO_MONTH=
